# Local development template. Copy it: cp .env.example .env
# Production values live in Dokploy's Environment tab, never in the repo.

APP_ENV=local

# HTTP listen port (default 8080 when unset; the frontend dev config expects 9000)
PORT=9000

# Postgres connection URL (docker compose starts this instance on 5433)
DATABASE_URL=postgres://postgres:postgres@localhost:5433/monexa?sslmode=disable

# Secrets: any string works locally; use long random values in production
JWT_SECRET=change-me-random-string-at-least-32-bytes
PPID_SECRET=change-me-different-random-string-at-least-32-bytes
ACCESS_TOKEN_DURATION=168h
REFRESH_TOKEN_DURATION=720h

# exchangerate-api.com; without a real key the daily job logs an error and fallback rates are used
EXCHANGE_RATE_API_KEY=your-exchange-rate-api-key

# Resend transactional email; the placeholder key makes sends fail, which is fine locally
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_NAME=Monexa
RESEND_FROM_ADDRESS=no-reply@example.com

# Used to build links in emails
FRONTEND_URL=http://localhost:5173

# Comma-separated allowed origins; unset allows any origin (local only)
CORS_ORIGINS=http://localhost:5173

# Any value other than "false" (including unset) enables the legal-acceptance flow
LEGAL_COMPLIANCE_ENABLED=false
