{
  "name": "monexa-mcp-server",
  "version": "2.0.0",
  "private": true,
  "description": "Remote MCP server for the Monexa personal finance API",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "tsx scripts/check.ts",
    "docs": "tsx scripts/gen-docs.ts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/emilijan-koteski/monexa"
  },
  "dependencies": {
    "@modelcontextprotocol/express": "2.0.2",
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/server": "2.3.0",
    "express": "5.2.1",
    "lru-cache": "11.5.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.0",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
